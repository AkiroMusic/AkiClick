{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.akiclick.app",
  "productName": "AkiClick",
  "version": "1.0.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AkiClick",
        "width": 380,
        "height": 420,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {}
    }
  },
  "plugins": {
    "globalShortcut": {
      "shortcut": "F9"
    },
    "shell": {
      "open": true
    }
  }
}